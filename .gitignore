# RTR-RE:Symbiose standalone tree — owns its own git history
# Runtime index + live config stay out of the repo
.cocoindex_code/
.opencode/
node_modules/
__pycache__/
*.pyc
.lake/
formal/.lake/
dist/
*.egg-info/
.venv/
state/
# Via negativa 2026-10-27: generated intermediates stay on disk, out of the repo
.ruff_cache/
*.log
media/frames-*/
eval/results/*-todo6.json
eval/results/*-prefix.json
eval/results/*-prefix.md
eval/results/graded-pool.json
eval/results/calibration.json
eval/results/calibration.md
# Runtime keeper memory (session spans) — regenerable, stays out of git
directives/sessions/

# mjs plugin source files (shipped in sdist) — source deliverables, tracked
!mjs/.opencode/
!mjs/.opencode/plugins/
!mjs/.opencode/plugins/rtr.mjs
!mjs/.opencode/plugins/rtr-frontmatter.cjs
!mjs/.opencode/command/
!mjs/.opencode/command/rtr.md
