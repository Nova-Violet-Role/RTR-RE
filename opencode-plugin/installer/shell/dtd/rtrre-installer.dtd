<!-- RTR-RE Installer DTD  .............................................. -->
<!-- file: rtrre-installer.dtd
-->

<!-- RTR-RE Installer DTD

     This is the driver file for the RTR-RE installer shell, a modular
     XML application in the XHTML family tradition. The shell markup is
     declared here as a first-class member of the RTR-RE DTD family:
     the same structural discipline that powers retrieval (inventory
     headers, family signatures, lineage) governs the product's own
     gateway.

     Family lineage: XHTML 1.1 (W3C) — this driver follows the modular
     driver/module pattern of xhtml11.dtd: a driver declares feature
     switches and includes modules; modules declare the vocabulary.

     Public identifier:

         "-//Nova-Violet-Role//DTD RTR-RE Installer 1.0//EN"
-->
<!ENTITY % RTRRE.version  "-//Nova-Violet-Role//DTD RTR-RE Installer 1.0//EN" >

<!-- Feature-test entities (module switches) — the customization-layer
     pattern from the DTD family architecture. Each module is included
     by default; a repository or build that switches one to IGNORE
     loses that vocabulary.
-->
<!ENTITY % rtrre-ui.module        "INCLUDE" >
<!ENTITY % rtrre-presets.module    "INCLUDE" >
<!ENTITY % rtrre-cockpit.module    "INCLUDE" >
<!ENTITY % rtrre-easter.module     "INCLUDE" >

<!-- The UI module carries the shared vocabulary (screens, cards,
     components, panels, plan, progress, log). Declared first so the
     more specific modules can extend it.
-->
<!ENTITY % rtrre-ui.mod
     PUBLIC "-//Nova-Violet-Role//ELEMENTS RTR-RE Installer UI 1.0//EN"
            "rtrre-installer-ui.mod" >
%rtrre-ui.mod;

<!-- The installer is an XHTML-family application: the document element
     is html, the namespace is XHTML, and the body carries the shell.
     The DOCTYPE on index.html is:

       <!DOCTYPE html PUBLIC
         "-//Nova-Violet-Role//DTD RTR-RE Installer 1.0//EN"
         "dtd/rtrre-installer.dtd">

     Browsers do not validate; the declaration is the contract that our
     own tooling (the DTD extractor) reads and profiles.
-->
