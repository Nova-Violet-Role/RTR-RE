{
  "name": "rtr-re-opencode-plugin",
  "version": "1.2.1",
  "description": "RTR-RE:Symbiose OpenCode plugins — keeper (server) and ctrl+p palette (tui)",
  "keywords": [
    "opencode-plugin",
    "opencode",
    "memory",
    "keeper",
    "context",
    "symbiose",
    "rag"
  ],
  "license": "AGPL-3.0-or-later OR EUPL-1.2",
  "author": {
    "name": "Nova-Violet Role ORG"
  },
  "homepage": "https://github.com/Nova-Violet-Role/RTR-RE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nova-Violet-Role/RTR-RE.git",
    "directory": "opencode-plugin"
  },
  "main": "./rtr-re-keeper.js",
  "exports": {
    ".": "./rtr-re-keeper.js",
    "./keeper": "./rtr-re-keeper.js",
    "./tui": "./rtr-re-tui.tsx"
  },
  "bin": {
    "rtr-re-installer": "./installer-bin.mjs"
  },
  "files": [
    "rtr-re-keeper.js",
    "rtr-re-tui.tsx",
    "assets/",
    "installer-bin.mjs",
    "installer/",
    "package.json"
  ],
  "scripts": {
    "test": "bun test rtr-re-keeper.test.mjs rtr-re-tui.test.ts",
    "prepack": "node -e \"const fs=require('fs'),p=require('path');const src=p.join('..','installer');const dst=p.join('installer');fs.rmSync(dst,{recursive:true,force:true});fs.cpSync(src,dst,{recursive:true,filter:(s)=>!s.includes('__pycache__')});console.log('installer copied into package')\""
  },
  "dependencies": {
    "solid-js": "^1.9.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
